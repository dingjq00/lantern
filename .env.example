# LLM provider（DeepSeek 官方：https://api.deepseek.com）
# V4 模型 ID：deepseek-v4-flash（快）/ deepseek-v4-pro（强）
# deepseek-chat / deepseek-reasoner 将于 2026-07-24 停用
# 主路径用 flash；级联升级用 pro（ReAct 会自动关闭 thinking 并走 JSON 输出）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_ESCALATION_MODEL=deepseek-v4-pro

# Optional dedicated summarize provider
LLM_SUMMARIZE_BASE_URL=
LLM_SUMMARIZE_API_KEY=
LLM_SUMMARIZE_MODEL=

# YAML tool catalog
TOOLS_DIR=./skills

# EAM data source
EAM_API_BASE_URL=http://localhost:48080
EAM_TENANT_ID=1
EAM_USERNAME=
EAM_PASSWORD=

# EDHR data source
EDHR_BASE_URL=https://localhost:8443
EDHR_CLIENT_ID=
EDHR_CLIENT_SECRET=

# MES data source
MES_BASE_URL=https://localhost:443
MES_CLIENT_ID=
MES_CLIENT_SECRET=

# LLM provider（DeepSeek 官方：https://api.deepseek.com）
# V4 模型 ID：deepseek-v4-flash（快）/ deepseek-v4-pro（强）
# deepseek-chat / deepseek-reasoner 将于 2026-07-24 停用
# 主路径用 flash；级联升级用 pro（ReAct 会自动关闭 thinking 并走 JSON 输出）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_ESCALATION_MODEL=deepseek-v4-pro

# Optional dedicated summarize provider
LLM_SUMMARIZE_BASE_URL=
LLM_SUMMARIZE_API_KEY=
LLM_SUMMARIZE_MODEL=

# YAML tool catalog
TOOLS_DIR=./skills

# ============ 启用哪些后端系统（运行时过滤）============
# 逗号分隔；不填或为空 = 全部启用（向后兼容）
# 影响范围：① lantern router/prompt 看到的系统；② LLM tool 列表；③ MCP server tool 注册
# 例：
#   ENABLED_SYSTEMS=jsy              → 同事开发 JSY 时只挂这一个
#   ENABLED_SYSTEMS=eam,mes,jsy      → 师傅本机三系统
#   ENABLED_SYSTEMS=                 → 全部启用（默认）
# 注意：mcp-server 子进程独立读此 env，要确保两边一致
ENABLED_SYSTEMS=

# EAM data source
EAM_API_BASE_URL=http://localhost:48080
EAM_TENANT_ID=1
EAM_USERNAME=
EAM_PASSWORD=

# EDHR data source
EDHR_BASE_URL=https://localhost:8443
EDHR_CLIENT_ID=
EDHR_CLIENT_SECRET=

# MES data source
MES_BASE_URL=https://localhost:443
MES_CLIENT_ID=
MES_CLIENT_SECRET=

# JSY data source（南厂酿酒车间，.NET Web API + JWT）
# 详细接入说明见 docs/jsy-onboarding.md
JSY_API_BASE_URL=http://localhost:8080
JSY_USERNAME=
JSY_PASSWORD=
# JSY_GOD_TOKEN=1  # 联调旁路（上帝口令 oiiaioiiiai）— 严禁生产
